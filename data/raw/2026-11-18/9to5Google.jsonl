{"title": "Phone by Google 246 rolls out gradient icon redesign on Android [U]", "link": "https://9to5google.com/2026/11/16/phone-by-google-246-new-icon/", "summary": "<div class=\"feat-image\"><img src=\"https://9to5google.com/wp-content/uploads/sites/4/2026/11/Google-Messages-Phone-Contacts-icon-gradient-redesign.webp?w=1600\" /></div><p class=\"wp-block-paragraph\">Following the <a href=\"https://9to5google.com/2026/11/02/google-messages-phone-icon-gradient-redesign/\">Messages update earlier this week</a>, Phone by Google has received its redesigned gradient icon in the beta channel.</p>\n\n\n\n <a class=\"more-link\" href=\"https://9to5google.com/2026/11/16/phone-by-google-246-new-icon/#more-735846\">more…</a>", "published": "2026-11-16T10:54:00+00:00", "source": "9to5Google", "category": "subscription", "matched_entities": {}, "logged_at": "2026-11-18T18:46:04.290718+00:00", "ontology": {"repo": "SubscriptionRadar", "category": "subscription", "ontology_version": "0.1.0", "evidence_policy_ids": ["traceable_url_required", "cross_reference_required", "non_authoritative_context_only"]}}
{"title": "Google beta lets you test ‘Create My Widget’ on Pixel 10 and 11 now", "link": "https://9to5google.com/2026/11/16/pixel-create-my-widget-beta/", "summary": "<div class=\"feat-image\"><img src=\"https://9to5google.com/wp-content/uploads/sites/4/2026/11/Pixel-11-Create-My-Widget.jpg?quality=82&strip=all&w=1600\" /></div><p class=\"wp-block-paragraph\">Following the <a href=\"https://9to5google.com/2026/11/10/november-2026-pixel-feature-drop/\">November 2026 Pixel Drop</a> announcement, Google is <a href=\"https://www.reddit.com/r/GooglePixel/comments/1xxv5oh/eager_to_try_create_my_widget_heres_how_to_get_it/\">letting</a> Pixel 10 and 11 owners try Create My Widget ahead of broader availability.</p>\n\n\n\n <a class=\"more-link\" href=\"https://9to5google.com/2026/11/16/pixel-create-my-widget-beta/#more-737795\">more…</a>", "published": "2026-11-16T08:39:58+00:00", "source": "9to5Google", "category": "subscription", "matched_entities": {}, "logged_at": "2026-11-18T18:46:04.290718+00:00", "ontology": {"repo": "SubscriptionRadar", "category": "subscription", "ontology_version": "0.1.0", "evidence_policy_ids": ["traceable_url_required", "cross_reference_required", "non_authoritative_context_only"]}}
{"title": "Gemini rolling out 66 new regional voices on Android and iOS, including 10+ UK dialects", "link": "https://9to5google.com/2026/11/16/gemini-rolling-out-66-new-regional-voices-on-android-and-ios-including-10-uk-dialects/", "summary": "<div class=\"feat-image\"><img src=\"https://9to5google.com/wp-content/uploads/sites/4/2026/03/Gemini-Live-Voice.jpg?quality=82&strip=all&w=1600\" /></div><p class=\"wp-block-paragraph\">Following a <a href=\"https://9to5google.com/2026/05/27/new-gemini-live-voices/\">preview at Google I/O</a>, Google is rolling out 66 new regional voices to the Gemini app on both Android and iOS today. The expansion introduces tailored voice options across U.S. English, U.K. English, Indian English, Hindi, Brazilian Portuguese, Indonesian, and Korean.</p>\n\n\n\n <a class=\"more-link\" href=\"https://9to5google.com/2026/11/16/gemini-rolling-out-66-new-regional-voices-on-android-and-ios-including-10-uk-dialects/#more-737578\">more…</a>", "published": "2026-11-16T08:00:00+00:00", "source": "9to5Google", "category": "subscription", "matched_entities": {}, "logged_at": "2026-11-18T18:46:04.290718+00:00", "ontology": {"repo": "SubscriptionRadar", "category": "subscription", "ontology_version": "0.1.0", "evidence_policy_ids": ["traceable_url_required", "cross_reference_required", "non_authoritative_context_only"]}}
